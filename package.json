{
  "name": "emailscraper",
  "version": "1.0.0",
  "description": "Email scraper using Firecrawl API to extract contact information from team profile pages",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cd client && npm run build",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node src/server.ts",
    "dev:client": "cd client && npm run dev",
    "scrape": "ts-node src/cli.ts",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": ["firecrawl", "scraper", "email", "contact"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
